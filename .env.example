# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Painel do Supabase > Project Settings > API).
# .env.local está no .gitignore e NUNCA deve ser commitado.

# URL do projeto, ex.: https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# Chave pública (anon / publishable). Ela pode ir para o navegador:
# quem protege os dados é o Row Level Security, não esta chave.
VITE_SUPABASE_ANON_KEY=
